{
  "info": {
    "_postman_id": "488f7fc1-3fcc-462b-a211-b5122c725ae2",
    "name": "Expensif API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local API requests. Register or log in first; the collection captures accessToken. Keep the cookie jar enabled for refresh. API keys are only for Telegram linking. Logout revokes the current refresh session and clears cookies; access JWTs expire naturally."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKeyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "linkedAccountId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "  const body = pm.response.json();",
          "  if (body.data && body.data.accessToken) { pm.collectionVariables.set(\"accessToken\", body.data.accessToken); }",
          "  if (body.data && body.data.key) { pm.collectionVariables.set(\"apiKeyId\", body.data.id); }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"example-password-123\",\n  \"name\": \"Example User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"example-password-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const csrf = pm.cookies.get(\"csrf_token\");",
                  "if (!csrf) { throw new Error(\"Log in first and enable the Postman cookie jar.\"); }",
                  "pm.variables.set(\"csrfToken\", csrf);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const csrf = pm.cookies.get(\"csrf_token\");",
                  "pm.variables.set(\"csrfToken\", csrf || \"\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "API keys",
      "item": [
        {
          "name": "Generate key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/api-key",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"telegram link\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "List keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/api-key?status=all&page=1&limit=10"
          },
          "response": []
        },
        {
          "name": "Revoke key",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/v1/api-key/{{apiKeyId}}"
          },
          "response": []
        },
        {
          "name": "Delete key",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/api-key/{{apiKeyId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Linked accounts",
      "item": [
        {
          "name": "List linked accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/linked-account"
          },
          "response": []
        },
        {
          "name": "Unlink account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/linked-account/{{linkedAccountId}}"
          },
          "response": []
        }
      ]
    }
  ]
}
