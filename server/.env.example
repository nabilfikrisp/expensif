# Environment: development, production, or test
NODE_ENV=development
DEPLOY_PROXY=none

# PostgreSQL development container (docker/compose.yml)
DATABASE_URL=postgres://expensif_dev:local_dev_password@127.0.0.1:5433/expensif_dev

# Server port
PORT=3000

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-api-keys

# Openrouter
OPENROUTER_API_KEY=your-openrouter-api-keys
OPENROUTER_MODEL=openrouter/free

# AUTH
# Generate independent random secrets of at least 32 characters; see README.md.
JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN_MINUTES=5m
REFRESH_TOKEN_EXPIRES_IN_DAYS=2h

# API KEY
API_KEY_SECRET=
API_KEY_REDEEM_WINDOW_MINUTES=15