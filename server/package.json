{
  "name": "expensif/server",
  "type": "module",
  "scripts": {
    "dev": "export DEBUG='grammy*' && tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lintformat": "pnpm typecheck && pnpm lint && pnpm run format:check",
    "db:generate": "drizzle-kit generate",
    "db:generate-named": "drizzle-kit generate --name",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:categories": "tsx scripts/seed-categories.ts",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "test": "node --import tsx scripts/test.ts watch",
    "test:run": "node --import tsx scripts/test.ts run",
    "test:standalone:expense-parser": "node --import tsx src/test/modules/expense/parser.check.ts",
    "test:standalone:bot-startup": "node --import tsx src/test/pkg/bot/telegram/start.check.ts",
    "test:standalone:shutdown": "node --import tsx src/test/shutdown.check.ts",
    "test:standalone:scheduler": "node --import tsx src/test/pkg/scheduler/scheduler.check.ts",
    "test:standalone:auth-origin": "node --import tsx src/test/pkg/http/auth-origin.check.ts",
    "test:standalone:logging": "node --import tsx src/test/pkg/logger/logging.check.ts",
    "test:standalone:http-logging": "node --import tsx src/test/pkg/http/logging.check.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@hono/node-server": "^2.0.8",
    "@hono/zod-openapi": "^1.5.1",
    "@hono/zod-validator": "^0.9.0",
    "@scalar/hono-api-reference": "^0.11.12",
    "ai": "^7.0.37",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.5",
    "grammy": "^1.45.1",
    "hono": "^4.12.27",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.2.4",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.4",
    "@hono/eslint-config": "^2.1.1",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "prettier": "3.9.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
