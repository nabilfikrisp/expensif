{
  "name": "expensif/server",
  "type": "module",
  "scripts": {
    "dev": "export DEBUG='grammy*' && tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lintformat": "pnpm lint && pnpm run format:check",
    "db:generate": "drizzle-kit generate",
    "db:generate-named": "drizzle-kit generate --name",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@hono/node-server": "^2.0.8",
    "@hono/zod-openapi": "^1.5.1",
    "@hono/zod-validator": "^0.9.0",
    "@libsql/client": "^0.17.4",
    "@scalar/hono-api-reference": "^0.11.12",
    "ai": "^7.0.37",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "grammy": "^1.45.1",
    "hono": "^4.12.27",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.2.4",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.4",
    "@hono/eslint-config": "^2.1.1",
    "@types/node": "^20.19.43",
    "drizzle-kit": "1.0.0-rc.4",
    "prettier": "3.9.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
